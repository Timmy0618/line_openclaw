# 專案名稱（同一台機器跑多個 bot 時，每個 bot 取不同名字）
# 影響 container 名稱 prefix，例如 my_bot-openclaw-1
COMPOSE_PROJECT_NAME=line_openclaw

# LINE Messaging API credentials
# https://developers.line.biz/console/ -> Messaging API channel -> Basic settings
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# OpenClaw host port（同一台機器跑多個 bot 時，每個 bot 用不同 port）
# OPENCLAW_HOST_PORT=19001

# Optional overrides (defaults shown)
# OPENCLAW_TIMEOUT_SECONDS=25
# LOG_LEVEL=INFO
# GROUP_BUFFER_SIZE=20   # 每個群組 session 保留的近期訊息則數（被動監聽用）

# 存取控制：允許互動的 LINE userId（逗號分隔），空白 = 不限制
# 1-on-1 DM 時套用白名單；群組則只看是否被 @mention
# ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 允許 bot 回應的群組／聊天室 ID 白名單（逗號分隔），空白 = 不限制
# groupId 以 C 開頭，roomId 以 R 開頭，可在 bridge-logs 中看到
# ALLOWED_GROUP_IDS=Cc5344f9d596bfe9fc77d10d61479306e
